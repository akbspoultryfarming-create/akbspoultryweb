# Existing database and admin variables remain unchanged.
MONGO_URL=
DB_NAME=akbs_poultry
ADMIN_PASSWORD=

# Hostinger SMTP settings (configure these in the Hostinger Node.js app environment)
# The API accepts either variable name in each pair below - fill any one.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@akbspoultry.com
SMTP_PASSWORD=
# Alias supported: SMTP_PASS=
SMTP_FROM=info@akbspoultry.com
# Alias supported: SMTP_FROM_EMAIL=
ADMIN_EMAIL=info@akbspoultry.com
# Alias supported: ADMIN_EMAILS=
